{
  "info": {
    "_postman_id": "8277d60c-c99c-5191-ad16-5cd9978a2a53",
    "name": "brokerage-api",
    "description": "Requests for every endpoint of the brokerage API, with assertions. Run it top to bottom against a fresh local database (seed users 1-4; user 1 has the seed portfolio, the other users start empty). Re-runs pass: only the read-only seed portfolio is asserted with exact totals.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Instruments",
      "item": [
        {
          "name": "Search by ticker",
          "request": {
            "method": "GET",
            "header": [],
            "description": "Finds PAMP by ticker, case-insensitively, and saves its id as instrumentId for the order requests.",
            "url": {
              "raw": "{{baseUrl}}/instruments?query=pamp",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "instruments"
              ],
              "query": [
                {
                  "key": "query",
                  "value": "pamp"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"one stock named PAMP\", () => {",
                  "    const body = pm.response.json();",
                  "    pm.expect(body.content.length).to.eql(1);",
                  "    pm.expect(body.content[0].ticker).to.eql(\"PAMP\");",
                  "    pm.expect(body.content[0].type).to.eql(\"STOCK\");",
                  "    pm.expect(body.page.totalElements).to.eql(1);",
                  "});",
                  "pm.environment.set('instrumentId', pm.response.json().content[0].id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Search by name",
          "request": {
            "method": "GET",
            "header": [],
            "description": "Matches part of the name, not only the ticker. Each result has id, ticker, name and type.",
            "url": {
              "raw": "{{baseUrl}}/instruments?query=banco",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "instruments"
              ],
              "query": [
                {
                  "key": "query",
                  "value": "banco"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"every result has banco in its name\", () => {",
                  "    const body = pm.response.json();",
                  "    pm.expect(body.content.length).to.be.above(0);",
                  "    body.content.forEach(i => pm.expect(i.name.toLowerCase()).to.include(\"banco\"));",
                  "    pm.expect(body.content[0]).to.have.all.keys(\"id\", \"ticker\", \"name\", \"type\");",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Search ignoring accents",
          "request": {
            "method": "GET",
            "header": [],
            "description": "The query \"compania\" finds the name with an accent (Compañía).",
            "url": {
              "raw": "{{baseUrl}}/instruments?query=compania",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "instruments"
              ],
              "query": [
                {
                  "key": "query",
                  "value": "compania"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"finds the accented name\", () => {",
                  "    const body = pm.response.json();",
                  "    pm.expect(body.content.map(i => i.ticker)).to.include(\"INTR\");",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Search with pagination",
          "request": {
            "method": "GET",
            "header": [],
            "description": "page and size are query parameters; the page object reports the totals. Page 1 of size 2 is the second page.",
            "url": {
              "raw": "{{baseUrl}}/instruments?query=banco&size=2&page=1",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "instruments"
              ],
              "query": [
                {
                  "key": "query",
                  "value": "banco"
                },
                {
                  "key": "size",
                  "value": "2"
                },
                {
                  "key": "page",
                  "value": "1"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"second page of two results\", () => {",
                  "    const body = pm.response.json();",
                  "    pm.expect(body.page.size).to.eql(2);",
                  "    pm.expect(body.page.number).to.eql(1);",
                  "    pm.expect(body.content.length).to.be.at.most(2);",
                  "    pm.expect(body.page.totalElements).to.be.above(2);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Blank query is rejected",
          "request": {
            "method": "GET",
            "header": [],
            "description": "A blank query is a 400 VALIDATION_FAILED that names the query field.",
            "url": {
              "raw": "{{baseUrl}}/instruments?query=%20",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "instruments"
              ],
              "query": [
                {
                  "key": "query",
                  "value": "%20"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 400\", () => pm.response.to.have.status(400));",
                  "pm.test(\"VALIDATION_FAILED on query\", () => {",
                  "    const body = pm.response.json();",
                  "    pm.expect(body.code).to.eql(\"VALIDATION_FAILED\");",
                  "    pm.expect(body.requestId).to.be.a(\"string\");",
                  "    pm.expect(body.errors.map(e => e.field)).to.include(\"query\");",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Portfolio",
      "item": [
        {
          "name": "Seed user 1 portfolio",
          "request": {
            "method": "GET",
            "header": [],
            "description": "Read-only seed data: the exact values of user 1's portfolio, with its short position in BMA.",
            "url": {
              "raw": "{{baseUrl}}/users/1/portfolio",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "users",
                "1",
                "portfolio"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"seed totals\", () => {",
                  "    const body = pm.response.json();",
                  "    pm.expect(body.userId).to.eql(1);",
                  "    pm.expect(body.totalValue.amount).to.eql(889756.0);",
                  "    pm.expect(body.availableCash.amount).to.eql(627500.0);",
                  "    pm.expect(body.totalValue.currency).to.eql(\"ARS\");",
                  "});",
                  "pm.test(\"seed positions\", () => {",
                  "    const body = pm.response.json();",
                  "    const bySymbol = Object.fromEntries(body.positions.map(p => [p.ticker, p]));",
                  "    pm.expect(Object.keys(bySymbol).sort()).to.eql([\"BMA\", \"METR\", \"PAMP\"]);",
                  "    pm.expect(bySymbol.BMA.quantity).to.eql(-10);",
                  "    pm.expect(bySymbol.METR.quantity).to.eql(500);",
                  "    pm.expect(bySymbol.PAMP.quantity).to.eql(40);",
                  "});"
                ]
              }
            }
          ]
        },
        {
