          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"the saved deposit\", () => {",
                  "    const body = pm.response.json();",
                  "    pm.expect(body.id).to.eql(Number(pm.environment.get('transferId')));",
                  "    pm.expect(body.type).to.eql(\"CASH_IN\");",
                  "    pm.expect(body.status).to.eql(\"COMPLETED\");",
                  "});"
                ]
              }
            }
          ]
        },
