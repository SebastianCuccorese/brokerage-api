    {
      "name": "Transfers",
      "item": [
        {
          "name": "CASH_IN to fund the user",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "description": "Deposits 50000 pesos. A deposit is always COMPLETED.",
            "url": {
              "raw": "{{baseUrl}}/users/{{userId}}/transfers",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "users",
                "{{userId}}",
                "transfers"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\"type\": \"CASH_IN\", \"amount\": 50000}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 201\", () => pm.response.to.have.status(201));",
                  "pm.test(\"COMPLETED deposit\", () => {",
                  "    const body = pm.response.json();",
                  "    pm.expect(body.type).to.eql(\"CASH_IN\");",
                  "    pm.expect(body.status).to.eql(\"COMPLETED\");",
                  "    pm.expect(body.amount.amount).to.eql(50000.0);",
                  "    pm.expect(body.rejectionReason).to.be.null;",
                  "    pm.expect(body.userId).to.eql(Number(pm.environment.get('userId')));",
                  "});",
                  "pm.environment.set('transferId', pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
          "name": "CASH_OUT within funds",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "description": "Withdraws 12500.50, which the user can cover after the deposit.",
            "url": {
              "raw": "{{baseUrl}}/users/{{userId}}/transfers",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "users",
                "{{userId}}",
                "transfers"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\"type\": \"CASH_OUT\", \"amount\": 12500.50}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 201\", () => pm.response.to.have.status(201));",
                  "pm.test(\"COMPLETED withdrawal\", () => {",
                  "    const body = pm.response.json();",
                  "    pm.expect(body.type).to.eql(\"CASH_OUT\");",
                  "    pm.expect(body.status).to.eql(\"COMPLETED\");",
                  "    pm.expect(body.amount.amount).to.eql(12500.5);",
                  "    pm.expect(body.rejectionReason).to.be.null;",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "CASH_OUT over the available pesos",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "description": "A withdrawal the user cannot cover is stored as REJECTED and still answers 201, with the reason.",
            "url": {
              "raw": "{{baseUrl}}/users/{{userId}}/transfers",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "users",
                "{{userId}}",
                "transfers"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\"type\": \"CASH_OUT\", \"amount\": 900000000}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 201\", () => pm.response.to.have.status(201));",
                  "pm.test(\"REJECTED for lack of cash\", () => {",
                  "    const body = pm.response.json();",
                  "    pm.expect(body.status).to.eql(\"REJECTED\");",
                  "    pm.expect(body.rejectionReason).to.eql(\"INSUFFICIENT_CASH\");",
                  "    pm.expect(body.id).to.be.a('number');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Transfer history",
          "request": {
            "method": "GET",
            "header": [],
            "description": "Newest first: the rejected withdrawal, then the completed one, then the deposit.",
            "url": {
              "raw": "{{baseUrl}}/users/{{userId}}/transfers",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "users",
                "{{userId}}",
                "transfers"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"newest first, with the three made above\", () => {",
                  "    const list = pm.response.json();",
                  "    pm.expect(list.length).to.be.at.least(3);",
                  "    pm.expect(list.every(t => t.userId === Number(pm.environment.get(\"userId\")))).to.be.true;",
                  "    const ids = list.map(t => t.id);",
                  "    pm.expect(ids).to.eql([...ids].sort((a, b) => b - a));",
                  "    pm.expect(list.map(t => t.id)).to.include(Number(pm.environment.get(\"transferId\")));",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Get one transfer",
          "request": {
            "method": "GET",
            "header": [],
            "description": "Reads back the deposit saved as transferId.",
            "url": {
              "raw": "{{baseUrl}}/users/{{userId}}/transfers/{{transferId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "users",
                "{{userId}}",
